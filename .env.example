# ============================================================================
# Namma Ooru AI - Environment Configuration Example
# Copy this file to .env and customize values
# ============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL / SQLite fallback)
# For local SQLite (Default for quick demo):
DATABASE_URL=sqlite:///./namma_ooru.db
# For PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/namma_ooru_db

# Security
SECRET_KEY=namma-ooru-ai-cybernaut-hackathon-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM API Configuration (Optional: Gemini API)
# If provided, advanced NLP reasoning is used. Otherwise, built-in intelligent rule & semantic model is used.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Municipal Corporation Details
MUNICIPALITY_NAME=Greater Chennai Corporation & Tamil Nadu Urban Local Bodies
SUPPORT_HELPLINE=1913
